{
  "$description": "Feinschliff Dark — Inverted-canvas variant of Feinschliff — navy-900 surface with warm paper as body ink.",
  "$theme_for": "feinschliff",
  "color": {
    "$type": "color",
    "accent":       { "$value": "#E4C27A", "$description": "Primary gold — the only accent. Use sparingly." },
    "accent-hover": { "$value": "#C9A24A", "$description": "Pressed / printed gold." },
    "highlight":    { "$value": "#FBE6B3", "$description": "Hover / on-dark accent gold." },
    "ink":          { "$value": "#FAF8F3", "$description": "Body text on dark — high contrast." },
    "chapter-slab": { "$value": "#070F1F", "$description": "Deepest contrast band (navy-900 — below canvas tone). Chapter dividers sit on this." },
    "graphite":     { "$value": "#A9BCD6", "$description": "Secondary text." },
    "steel":        { "$value": "#6E8BB6", "$description": "Tertiary / muted labels." },
    "silver":       { "$value": "#6E8BB6", "$description": "Muted text on dark / soft labels." },
    "fog":          { "$value": "#1F3056", "$description": "Warm hairlines on light." },
    "paper":        { "$value": "#0B1A33", "$description": "Warm paper — page on light." },
    "paper-2":      { "$value": "#0F2040", "$description": "Raised surface on light." },
    "off-white":    { "$value": "#FAF8F3", "$description": "Body text on dark." },
    "off-white-2":  { "$value": "#A9BCD6", "$description": "Muted text on dark." },
    "navy-800":     { "$value": "#070F1F", "$description": "Surface on dark." },
    "navy-700":     { "$value": "#0B1A33", "$description": "Raised surface on dark." },
    "navy-600":     { "$value": "#0F2040", "$description": "Gem mid-facet." },
    "navy-500":     { "$value": "#162A4A", "$description": "Gem upper-facet." },
    "navy-400":     { "$value": "#1E3258", "$description": "Gem highlight." },
    "navy-300":     { "$value": "#2D4770", "$description": "Lifted on dark." },
    "navy-200":     { "$value": "#6E8BB6", "$description": "Muted on dark." },
    "white":        { "$value": "#FAF8F3" }
  }
}
