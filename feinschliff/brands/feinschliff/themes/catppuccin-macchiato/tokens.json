{
  "$description": "Catppuccin Macchiato — Medium-dark Catppuccin flavor between Frappé and Mocha — gentle contrast. Upstream catppuccin/palette (MIT).",
  "$theme_for": "feinschliff",
  "color": {
    "$type": "color",
    "accent":       { "$value": "#C6A0F6", "$description": "Primary gold — the only accent. Use sparingly." },
    "accent-hover": { "$value": "#B7BDF8", "$description": "Pressed / printed gold." },
    "highlight":    { "$value": "#F5BDE6", "$description": "Hover / on-dark accent gold." },
    "black":        { "$value": "#24273A", "$description": "Navy-900 — deepest." },
    "ink":          { "$value": "#CAD3F5", "$description": "Body text on dark — high contrast." },
    "chapter-slab": { "$value": "#181926", "$description": "Deepest contrast band (catppuccin mantle/crust) — chapter dividers." },
    "graphite":     { "$value": "#A5ADCB", "$description": "Secondary text." },
    "steel":        { "$value": "#939AB7", "$description": "Tertiary / muted labels." },
    "silver":       { "$value": "#939AB7", "$description": "Muted text on dark / soft labels." },
    "fog":          { "$value": "#363A4F", "$description": "Warm hairlines on light." },
    "paper":        { "$value": "#24273A", "$description": "Warm paper — page on light." },
    "paper-2":      { "$value": "#363A4F", "$description": "Raised surface on light." },
    "off-white":    { "$value": "#CAD3F5", "$description": "Body text on dark." },
    "off-white-2":  { "$value": "#A5ADCB", "$description": "Muted text on dark." },
    "rule-dark":    { "$value": "#494D64", "$description": "Hairlines on dark." },
    "navy-800":     { "$value": "#181926", "$description": "Surface on dark." },
    "navy-700":     { "$value": "#1E2030", "$description": "Raised surface on dark." },
    "navy-600":     { "$value": "#363A4F", "$description": "Gem mid-facet." },
    "navy-500":     { "$value": "#494D64", "$description": "Gem upper-facet." },
    "navy-400":     { "$value": "#5B6078", "$description": "Gem highlight." },
    "navy-300":     { "$value": "#6E738D", "$description": "Lifted on dark." },
    "navy-200":     { "$value": "#939AB7", "$description": "Muted on dark." },
    "navy-100":     { "$value": "#B8C0E0", "$description": "Soft divider on light." },
    "white":        { "$value": "#CAD3F5" },
    "severity-low":    { "$value": "#a6da95", "$description": "Risk severity / status: low — palette-derived." },
    "severity-medium": { "$value": "#eed49f", "$description": "Risk severity / status: medium — palette-derived." },
    "severity-high":   { "$value": "#ed8796", "$description": "Risk severity / status: high — palette-derived." },
    "status-done":     { "$value": "#a6da95", "$description": "Status: done — alias of severity-low." },
    "status-current":  { "$value": "#eed49f", "$description": "Status: in progress — alias of severity-medium." },
    "status-next":     { "$value": "#6e738d", "$description": "Status: not yet started — muted neutral." }
  }
}
