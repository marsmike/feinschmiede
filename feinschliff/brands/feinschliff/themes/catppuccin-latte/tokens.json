{
  "$description": "Catppuccin Latte — Light, warm pastel theme — Catppuccin's daylight flavor. Upstream catppuccin/palette (MIT).",
  "$theme_for": "feinschliff",
  "color": {
    "$type": "color",
    "accent":       { "$value": "#8839EF", "$description": "Primary gold — the only accent. Use sparingly." },
    "accent-hover": { "$value": "#7287FD", "$description": "Pressed / printed gold." },
    "highlight":    { "$value": "#EA76CB", "$description": "Hover / on-dark accent gold." },
    "black":        { "$value": "#4C4F69", "$description": "Navy-900 — deepest." },
    "ink":          { "$value": "#4C4F69", "$description": "Body ink on light = navy-900." },
    "graphite":     { "$value": "#5C5F77", "$description": "Secondary text." },
    "steel":        { "$value": "#6C6F85", "$description": "Tertiary / muted labels." },
    "silver":       { "$value": "#ACB0BE", "$description": "Muted text on dark / soft labels." },
    "fog":          { "$value": "#BCC0CC", "$description": "Warm hairlines on light." },
    "paper":        { "$value": "#EFF1F5", "$description": "Warm paper — page on light." },
    "paper-2":      { "$value": "#E6E9EF", "$description": "Raised surface on light." },
    "off-white":    { "$value": "#EFF1F5", "$description": "Body text on dark." },
    "off-white-2":  { "$value": "#CCD0DA", "$description": "Muted text on dark." },
    "rule-dark":    { "$value": "#ACB0BE", "$description": "Hairlines on dark." },
    "navy-800":     { "$value": "#4C4F69", "$description": "Surface on dark." },
    "navy-700":     { "$value": "#5C5F77", "$description": "Raised surface on dark." },
    "navy-600":     { "$value": "#6C6F85", "$description": "Gem mid-facet." },
    "navy-500":     { "$value": "#7C7F93", "$description": "Gem upper-facet." },
    "navy-400":     { "$value": "#8C8FA1", "$description": "Gem highlight." },
    "navy-300":     { "$value": "#9CA0B0", "$description": "Lifted on dark." },
    "navy-200":     { "$value": "#ACB0BE", "$description": "Muted on dark." },
    "navy-100":     { "$value": "#CCD0DA", "$description": "Soft divider on light." },
    "severity-low":    { "$value": "#40a02b", "$description": "Risk severity / status: low — palette-derived." },
    "severity-medium": { "$value": "#df8e1d", "$description": "Risk severity / status: medium — palette-derived." },
    "severity-high":   { "$value": "#d20f39", "$description": "Risk severity / status: high — palette-derived." },
    "status-done":     { "$value": "#40a02b", "$description": "Status: done — alias of severity-low." },
    "status-current":  { "$value": "#df8e1d", "$description": "Status: in progress — alias of severity-medium." },
    "status-next":     { "$value": "#6c6f85", "$description": "Status: not yet started — muted neutral." }
  }
}
