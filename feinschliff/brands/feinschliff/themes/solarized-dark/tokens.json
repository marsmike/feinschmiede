{
  "$description": "Solarized Dark — Ethan Schoonover's classic precision-engineered palette — warm yellows on cool teal-black. Upstream ethanschoonover.com/solarized (MIT).",
  "$theme_for": "feinschliff",
  "color": {
    "$type": "color",
    "accent":       { "$value": "#B58900", "$description": "Primary gold — the only accent. Use sparingly." },
    "accent-hover": { "$value": "#CB4B16", "$description": "Pressed / printed gold." },
    "highlight":    { "$value": "#2AA198", "$description": "Hover / on-dark accent gold." },
    "black":        { "$value": "#002B36", "$description": "Navy-900 — deepest." },
    "ink":          { "$value": "#002B36", "$description": "Body ink on light = navy-900." },
    "graphite":     { "$value": "#073642", "$description": "Secondary text." },
    "steel":        { "$value": "#586E75", "$description": "Tertiary / muted labels." },
    "silver":       { "$value": "#839496", "$description": "Muted text on dark / soft labels." },
    "fog":          { "$value": "#EEE8D5", "$description": "Warm hairlines on light." },
    "paper":        { "$value": "#FDF6E3", "$description": "Warm paper — page on light." },
    "paper-2":      { "$value": "#EEE8D5", "$description": "Raised surface on light." },
    "off-white":    { "$value": "#EEE8D5", "$description": "Body text on dark." },
    "off-white-2":  { "$value": "#93A1A1", "$description": "Muted text on dark." },
    "rule-dark":    { "$value": "#586E75", "$description": "Hairlines on dark." },
    "navy-800":     { "$value": "#002B36", "$description": "Surface on dark." },
    "navy-700":     { "$value": "#073642", "$description": "Raised surface on dark." },
    "navy-600":     { "$value": "#586E75", "$description": "Gem mid-facet." },
    "navy-500":     { "$value": "#657B83", "$description": "Gem upper-facet." },
    "navy-400":     { "$value": "#839496", "$description": "Gem highlight." },
    "navy-300":     { "$value": "#93A1A1", "$description": "Lifted on dark." },
    "navy-200":     { "$value": "#839496", "$description": "Muted on dark." },
    "navy-100":     { "$value": "#EEE8D5", "$description": "Soft divider on light." },
    "white":        { "$value": "#FDF6E3" },
    "severity-low":    { "$value": "#859900", "$description": "Risk severity / status: low — palette-derived." },
    "severity-medium": { "$value": "#b58900", "$description": "Risk severity / status: medium — palette-derived." },
    "severity-high":   { "$value": "#dc322f", "$description": "Risk severity / status: high — palette-derived." },
    "status-done":     { "$value": "#859900", "$description": "Status: done — alias of severity-low." },
    "status-current":  { "$value": "#b58900", "$description": "Status: in progress — alias of severity-medium." },
    "status-next":     { "$value": "#586e75", "$description": "Status: not yet started — muted neutral." }
  }
}
