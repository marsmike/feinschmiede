{
  "$description": "Nord — Arctic, north-bluish color palette designed for clear and minimal interfaces. Upstream nordtheme/nord (MIT).",
  "$theme_for": "feinschliff",
  "color": {
    "$type": "color",
    "accent":       { "$value": "#88C0D0", "$description": "Primary gold — the only accent. Use sparingly." },
    "accent-hover": { "$value": "#81A1C1", "$description": "Pressed / printed gold." },
    "highlight":    { "$value": "#5E81AC", "$description": "Hover / on-dark accent gold." },
    "black":        { "$value": "#2E3440", "$description": "Navy-900 — deepest." },
    "ink":          { "$value": "#ECEFF4", "$description": "Body text on dark — high contrast." },
    "chapter-slab": { "$value": "#2E3440", "$description": "Polar Night nord0 — deepest contrast band for chapter dividers." },
    "graphite":     { "$value": "#D8DEE9", "$description": "Secondary text." },
    "steel":        { "$value": "#81A1C1", "$description": "Tertiary / muted labels." },
    "silver":       { "$value": "#4C566A", "$description": "Muted text on dark / soft labels." },
    "fog":          { "$value": "#3B4252", "$description": "Warm hairlines on light." },
    "paper":        { "$value": "#2E3440", "$description": "Warm paper — page on light." },
    "paper-2":      { "$value": "#3B4252", "$description": "Raised surface on light." },
    "off-white":    { "$value": "#ECEFF4", "$description": "Body text on dark." },
    "off-white-2":  { "$value": "#D8DEE9", "$description": "Muted text on dark." },
    "rule-dark":    { "$value": "#3B4252", "$description": "Hairlines on dark." },
    "navy-800":     { "$value": "#2E3440", "$description": "Surface on dark." },
    "navy-700":     { "$value": "#3B4252", "$description": "Raised surface on dark." },
    "navy-600":     { "$value": "#434C5E", "$description": "Gem mid-facet." },
    "navy-500":     { "$value": "#4C566A", "$description": "Gem upper-facet." },
    "navy-400":     { "$value": "#4C566A", "$description": "Gem highlight." },
    "navy-300":     { "$value": "#D8DEE9", "$description": "Lifted on dark." },
    "navy-200":     { "$value": "#4C566A", "$description": "Muted on dark." },
    "navy-100":     { "$value": "#D8DEE9", "$description": "Soft divider on light." },
    "white":        { "$value": "#ECEFF4" },
    "severity-low":    { "$value": "#a3be8c", "$description": "Risk severity / status: low — palette-derived." },
    "severity-medium": { "$value": "#ebcb8b", "$description": "Risk severity / status: medium — palette-derived." },
    "severity-high":   { "$value": "#bf616a", "$description": "Risk severity / status: high — palette-derived." },
    "status-done":     { "$value": "#a3be8c", "$description": "Status: done — alias of severity-low." },
    "status-current":  { "$value": "#ebcb8b", "$description": "Status: in progress — alias of severity-medium." },
    "status-next":     { "$value": "#4c566a", "$description": "Status: not yet started — muted neutral." }
  },
  "brief_defaults": {
    "verbosity": "concise",
    "image_style": "minimal",
    "frame": "scqa",
    "audience": "developer"
  }
}
