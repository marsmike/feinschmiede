{
  "$schema": "https://schemas.designtokens.org/draft-2/format.json",
  "$description": "Shapes — port of Microsoft's free 'The power of communication' (Shapes design) presentation template (powerpoint.cloud.microsoft). Scattered decorative geometry and a big blue title circle on white. Palette + fonts + slide dims are seeded by brand_decompile_all.py from the source theme; extends feinschliff for everything else.",
  "$default_theme": "default",
  "color": {
    "$type": "color",
    "accent": {
      "$value": "#C9A24A",
      "$description": "Primary gold — the only accent. Use sparingly."
    },
    "accent-hover": {
      "$value": "#8A6F2E",
      "$description": "Pressed / printed gold."
    },
    "highlight": {
      "$value": "#E4C27A",
      "$description": "Hover / on-dark accent gold."
    },
    "black": {
      "$value": "#000000",
      "$description": "Display / deepest — source theme dk1."
    },
    "ink": {
      "$value": "#000000",
      "$description": "Body/title ink — source theme dk1."
    },
    "chapter-slab": {
      "$value": "#0B1A33",
      "$description": "Deepest contrast band for chapter dividers. In light brands = ink; in dark brands override to the brand's canvas-deeper neutral."
    },
    "graphite": {
      "$value": "#2D3A52",
      "$description": "Secondary text."
    },
    "steel": {
      "$value": "#5A6478",
      "$description": "Tertiary / muted labels."
    },
    "silver": {
      "$value": "#A9BCD6",
      "$description": "Muted text on dark / soft labels."
    },
    "chart-series-1": {
      "$value": "#C9A24A",
      "$description": "Categorical chart series 1 — gold."
    },
    "chart-series-2": {
      "$value": "#3A5B8C",
      "$description": "Categorical chart series 2 — blue."
    },
    "chart-series-3": {
      "$value": "#3F8553",
      "$description": "Categorical chart series 3 — green."
    },
    "chart-series-4": {
      "$value": "#A8442A",
      "$description": "Categorical chart series 4 — terracotta."
    },
    "chart-series-5": {
      "$value": "#5A6478",
      "$description": "Categorical chart series 5 — slate."
    },
    "chart-series-6": {
      "$value": "#6E8BB6",
      "$description": "Categorical chart series 6 — light blue."
    },
    "fog": {
      "$value": "#D6D1C2",
      "$description": "Warm hairlines on light."
    },
    "paper": {
      "$value": "#FFFFFF",
      "$description": "Canvas on light — source theme lt1."
    },
    "paper-2": {
      "$value": "#F4F1E8",
      "$description": "Raised surface on light."
    },
    "off-white": {
      "$value": "#F0ECE4",
      "$description": "Body text on dark."
    },
    "off-white-2": {
      "$value": "#D9D3C5",
      "$description": "Muted text on dark."
    },
    "rule-dark": {
      "$value": "#1F3056",
      "$description": "Hairlines on dark."
    },
    "navy-800": {
      "$value": "#0F2040",
      "$description": "Surface on dark."
    },
    "navy-700": {
      "$value": "#162A4A",
      "$description": "Raised surface on dark."
    },
    "navy-600": {
      "$value": "#1E3258",
      "$description": "Gem mid-facet."
    },
    "navy-500": {
      "$value": "#2D4770",
      "$description": "Gem upper-facet."
    },
    "navy-400": {
      "$value": "#3A5B8C",
      "$description": "Gem highlight."
    },
    "navy-300": {
      "$value": "#6E8BB6",
