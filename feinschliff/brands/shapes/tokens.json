  "slide": {
    "$type": "dimension",
    "width": {
      "$value": "1920px"
    },
    "height": {
      "$value": "1080px"
    },
    "padding-x": {
      "$value": "100px"
    },
    "padding-y-top": {
      "$value": "100px"
    },
    "padding-y-bottom": {
      "$value": "80px"
    },
    "left-rail": {
      "$value": "132",
      "$description": "87% of decompiled text nodes sit at x=132 (Shapes Microsoft template native padding)."
    },
    "rail-snap-enabled": {
      "$value": "1",
      "$description": "Engage the snap-to-rail post-pass."
    },
    "rail-snap-threshold": {
      "$value": "10",
      "$description": "Tight threshold — catches per-brand drift, leaves toolkit layouts at x=100 alone (diff > threshold)."
    },
    "width_emu": {
      "$value": "12192000",
      "$description": "Source PPTX slide width in EMU — drives emitter scaling."
    },
    "height_emu": {
      "$value": "6858000",
      "$description": "Source PPTX slide height in EMU — drives emitter scaling."
    }
  },
  "$image_provider": {
    "kind": "unsplash"
  },
  "asset_sources": {
    "$description": "Where this brand pulls images/icons from. Each source has a kind: 'static' (catalog-bundled, sha-pinned) or 'search' (BYO-key API, e.g. Unsplash, Iconify). See references/asset-sources-spec.md.",
    "default": {
      "kind": "unsplash",
      "$description": "Unsplash search-backed provider — UNSPLASH_ACCESS_KEY must be set in the environment."
    }
  },
  "typography": {
    "display_tracking_curve": {
      "32": -0.005,
      "56": -0.015,
      "96": -0.025,
      "160": -0.035
    },
    "tnum_slot_keys": [
      "kpi_value",
      "axis_tick",
      "table_cell",
      "change_pct",
      "year",
      "count"
    ]
  },
  "picture_treatment": "desat(0.3)",
  "locale": "en",
  "chart": {
    "chrome": "minimal",
    "axis_color_role": "fog",
    "legend_threshold": 4
  }
}
