{
  "$schema": "https://schemas.designtokens.org/draft-2/format.json",
  "$description": "Grundschule Ramspau — Schule im Grünen. Bespoke 8-layout pack. Wiese green + tief deep-ink + warm papier.",
  "$default_theme": "default",
  "color": {
    "$type": "color",
    "accent": {
      "$value": "#9eb05c",
      "$description": "Wiese — primary green. Claim bar, accent rules, agenda numerals. Nudged from source #A8B86B to clear WCAG 2.0:1 on papier."
    },
    "accent-hover": {
      "$value": "#8a9c50",
      "$description": "Pressed wiese."
    },
    "highlight": {
      "$value": "#c5d18d",
      "$description": "Lifted wiese for hover / on-dark accent."
    },
    "black": {
      "$value": "#3f4b2e",
      "$description": "Tief — deep-ink background, display title color."
    },
    "ink": {
      "$value": "#1f1f1c",
      "$description": "Tinte — body text on light."
    },
    "chapter-slab": {
      "$value": "#0B1A33",
      "$description": "Deepest contrast band for chapter dividers. In light brands = ink; in dark brands override to the brand's canvas-deeper neutral."
    },
    "graphite": {
      "$value": "#9a8f86",
      "$description": "Taupe — muted labels."
    },
    "steel": {
      "$value": "#9a8f86",
      "$description": "Taupe (same — gs-ramspau has no separate steel)."
    },
    "silver": {
      "$value": "#c8c1b8",
      "$description": "Lighter taupe."
    },
    "chart-series-1": {
      "$value": "#C9A24A",
      "$description": "Categorical chart series 1 — gold."
    },
    "chart-series-2": {
      "$value": "#3A5B8C",
      "$description": "Categorical chart series 2 — blue."
    },
    "chart-series-3": {
      "$value": "#3F8553",
      "$description": "Categorical chart series 3 — green."
    },
    "chart-series-4": {
      "$value": "#A8442A",
      "$description": "Categorical chart series 4 — terracotta."
    },
    "chart-series-5": {
      "$value": "#5A6478",
      "$description": "Categorical chart series 5 — slate."
    },
    "chart-series-6": {
      "$value": "#6E8BB6",
      "$description": "Categorical chart series 6 — light blue."
    },
    "fog": {
      "$value": "#dddcda",
      "$description": "Hairlines on light."
    },
    "paper": {
      "$value": "#f6f3ec",
      "$description": "Papier — warm canvas on light."
    },
    "paper-2": {
      "$value": "#ece7dc",
      "$description": "Body bg / photo placeholder fill."
    },
    "off-white": {
      "$value": "#f6f3ec",
      "$description": "Papier (text on dark)."
    },
    "off-white-2": {
      "$value": "#d9d3c5",
      "$description": "Muted text on dark."
    },
    "rule-dark": {
      "$value": "#34362a",
      "$description": "Hairlines on tief."
    },
    "navy-800": {
      "$value": "#0F2040",
      "$description": "Surface on dark."
    },
    "navy-700": {
      "$value": "#162A4A",
      "$description": "Raised surface on dark."
    },
    "navy-600": {
      "$value": "#1E3258",
      "$description": "Gem mid-facet."
    },
    "navy-500": {
      "$value": "#2D4770",
      "$description": "Gem upper-facet."
    },
    "navy-400": {
      "$value": "#3A5B8C",
      "$description": "Gem highlight."
    },
    "navy-300": {
      "$value": "#6E8BB6",
      "$description": "Lifted on dark."
    },
    "navy-200": {
      "$value": "#A9BCD6",
      "$description": "Muted on dark."
    },
    "navy-100": {
      "$value": "#D6E0EE",
      "$description": "Soft divider on light."
    },
    "white": {
      "$value": "#ffffff"
    },
    "severity-low": {
      "$value": "#3F8553",
      "$description": "Risk severity / status: low — palette-derived."
    },
    "severity-medium": {
      "$value": "#C9A24A",
      "$description": "Risk severity / status: medium — palette-derived."
    },
    "severity-high": {
      "$value": "#A8442A",
      "$description": "Risk severity / status: high — palette-derived."
    },
    "status-done": {
      "$value": "#3F8553",
      "$description": "Status: done — alias of severity-low."
    },
    "status-current": {
      "$value": "#C9A24A",
      "$description": "Status: in progress — alias of severity-medium."
    },
    "status-next": {
      "$value": "#5A6478",
      "$description": "Status: not yet started — muted neutral."
    }
  },
  "font-family": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Open Sans",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "body": {
      "$value": [
        "Open Sans",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "Consolas",
        "SF Mono",
        "Menlo",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "light": {
      "$value": 300
    },
    "regular": {
      "$value": 400
    },
    "medium": {
      "$value": 500
    },
    "semibold": {
      "$value": 600
    },
    "bold": {
      "$value": 700
    },
    "black": {
      "$value": 900
    }
  },
  "font-size": {
    "$type": "dimension",
    "$description": "Sizes match the shared 1920x1080 baseline.",
    "display": {
      "$value": "160px"
    },
    "display-xl": {
      "$value": "200px"
    },
    "huge": {
      "$value": "120px"
    },
    "slide-title": {
      "$value": "37px"
    },
    "title-l": {
      "$value": "80px"
    },
    "sub": {
      "$value": "44px"
    },
    "body": {
      "$value": "26px"
    },
    "eyebrow": {
      "$value": "18px"
    },
    "footer": {
      "$value": "16px"
    },
    "pgmeta": {
      "$value": "18px"
    },
    "kpi-value": {
      "$value": "120px"
    },
    "kpi-unit": {
      "$value": "40px"
    },
    "kpi-key": {
      "$value": "16px"
    },
    "kpi-delta": {
      "$value": "18px"
    },
    "act-title": {
      "$value": "56px"
    },
    "act-kicker": {
      "$value": "18px"
    },
    "tracker": {
      "$value": "16px"
    },
    "h-idx": {
      "$value": "16px"
    },
    "h-hd": {
      "$value": "32px"
    },
    "h-li": {
      "$value": "22px"
    },
    "lede": {
      "$value": "44px"
    },
    "col-num": {
      "$value": "14px"
    },
    "col-title": {
      "$value": "36px"
    },
    "col-title-q": {
      "$value": "28px"
    },
    "col-body": {
      "$value": "22px"
    },
    "btn": {
      "$value": "22px"
    },
    "chip": {
      "$value": "16px"
    },
    "bar-label": {
      "$value": "28px"
    },
    "bar-num": {
      "$value": "22px"
    },
    "quote": {
      "$value": "84px"
    },
    "quote-attr": {
      "$value": "20px"
    },
    "bignum": {
      "$value": "320px"
    },
    "agenda-num": {
      "$value": "18px"
    },
    "agenda-t": {
      "$value": "28px"
    },
    "agenda-d": {
      "$value": "20px"
    }
  },
  "slide": {
    "$type": "dimension",
    "width": {
      "$value": "1920px"
    },
    "height": {
      "$value": "1080px"
    },
    "padding-x": {
      "$value": "100px"
    },
    "padding-y-top": {
      "$value": "100px"
    },
    "padding-y-bottom": {
      "$value": "80px"
    },
    "left-rail": {
      "$value": "100",
      "$description": "Canonical body-content left edge. Snap-to-rail pulls drift here."
    },
    "rail-snap-enabled": {
      "$value": "1",
      "$description": "Engage the snap-to-rail post-pass for this brand (text only; structural rects/shapes pass through)."
    },
    "rail-snap-threshold": {
      "$value": "30",
      "$description": "Tolerance (px) for the snap-to-rail post-pass. Elements with |x − left-rail| ≤ threshold snap; further-out values are treated as deliberate indents."
    }
  },
  "$image_provider": {
    "kind": "unsplash"
  },
  "asset_sources": {
    "$description": "Where this brand pulls images/icons from. Each source has a kind: 'static' (catalog-bundled, sha-pinned) or 'search' (BYO-key API, e.g. Unsplash, Iconify). See references/asset-sources-spec.md.",
    "default": {
      "kind": "unsplash",
      "$description": "Unsplash search-backed provider — UNSPLASH_ACCESS_KEY must be set in the environment."
    }
  },
  "typography": {
    "display_tracking_curve": {
      "32": -0.005,
      "56": -0.015,
      "96": -0.025,
      "160": -0.035
    },
    "tnum_slot_keys": [
      "kpi_value",
      "axis_tick",
      "table_cell",
      "change_pct",
      "year",
      "count"
    ]
  },
  "picture_treatment": "desat(0.3)",
  "locale": "en",
  "chart": {
    "chrome": "minimal",
    "axis_color_role": "fog",
    "legend_threshold": 4
  }
}
