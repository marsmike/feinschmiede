    "bar-num": {
      "$value": "22px"
    },
    "quote": {
      "$value": "84px"
    },
    "quote-attr": {
      "$value": "20px"
    },
    "bignum": {
      "$value": "320px"
    },
    "agenda-num": {
      "$value": "18px"
    },
    "agenda-t": {
      "$value": "28px"
    },
    "agenda-d": {
      "$value": "20px"
    }
  },
  "slide": {
    "$type": "dimension",
    "width": {
      "$value": "1920px"
    },
    "height": {
      "$value": "1080px"
    },
    "padding-x": {
      "$value": "100px"
    },
    "padding-y-top": {
      "$value": "100px"
    },
    "padding-y-bottom": {
      "$value": "80px"
    },
    "left-rail": {
      "$value": "100",
      "$description": "Canonical body-content left edge. Snap-to-rail pulls drift here."
    },
    "rail-snap-enabled": {
      "$value": "1",
      "$description": "Engage the snap-to-rail post-pass for this brand (text only; structural rects/shapes pass through)."
    },
    "rail-snap-threshold": {
      "$value": "30",
      "$description": "Tolerance (px) for the snap-to-rail post-pass. Elements with |x − left-rail| ≤ threshold snap; further-out values are treated as deliberate indents."
    },
    "width_emu": {
      "$value": "12192000",
      "$description": "Source PPTX slide width in EMU — drives emitter scaling."
    },
    "height_emu": {
      "$value": "6858000",
      "$description": "Source PPTX slide height in EMU — drives emitter scaling."
    }
  },
  "$image_provider": {
    "kind": "unsplash"
  },
  "asset_sources": {
    "$description": "Where this brand pulls images/icons from. Each source has a kind: 'static' (catalog-bundled, sha-pinned) or 'search' (BYO-key API, e.g. Unsplash, Iconify). See references/asset-sources-spec.md.",
    "default": {
      "kind": "unsplash",
      "$description": "Unsplash search-backed provider — UNSPLASH_ACCESS_KEY must be set in the environment."
    }
  },
  "typography": {
    "display_tracking_curve": {
      "32": -0.005,
      "56": -0.015,
      "96": -0.025,
      "160": -0.035
    },
    "tnum_slot_keys": [
      "kpi_value",
      "axis_tick",
      "table_cell",
      "change_pct",
      "year",
      "count"
    ]
  },
  "picture_treatment": "desat(0.3)",
  "locale": "en",
  "chart": {
    "chrome": "minimal",
    "axis_color_role": "fog",
    "legend_threshold": 4
  }
}
