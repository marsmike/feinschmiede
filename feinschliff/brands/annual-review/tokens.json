    "col-title-q": {
      "$value": "28px"
    },
    "col-body": {
      "$value": "22px"
    },
    "btn": {
      "$value": "22px"
    },
    "chip": {
      "$value": "16px"
    },
    "bar-label": {
      "$value": "28px"
